# STAG Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider (choose one) ---
LLM_PROVIDER=openai
# Options: openai, anthropic

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Stream Source ---
STREAM_SOURCE=simulator
# Options: simulator, kafka, webhook

# Kafka (if STREAM_SOURCE=kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stag-events
KAFKA_GROUP_ID=stag-consumer
# Kafka records must carry the source's own stable event id in this field (none is minted)
KAFKA_ID_FIELD=id
KAFKA_MAX_RECORD_BYTES=1000000
# Poison-record coordinates kept in memory (payloads are never kept or logged)
KAFKA_DEAD_LETTER_MAX=1000
# What a processing failure does to the delivery: dead_letter (commit and continue) or halt (stop; redeliver after restart)
KAFKA_ON_FAILURE=dead_letter

# --- Storage ---
CHROMA_PERSIST_DIR=./data/chroma
GRAPH_PERSIST_PATH=./data/graph.json

# --- Trigger Engine ---
TRIGGER_EVAL_INTERVAL=2.0
TRIGGER_ANOMALY_THRESHOLD=0.75

# --- Generation ---
GENERATION_MAX_TOKENS=1024
GENERATION_TEMPERATURE=0.3

# --- TechOps Coordinator (deterministic backbone) ---
# When enabled, fired triggers are deduplicated and correlated into incident episodes;
# the LLM is only called on a material change (new incident, severity increase, new
# signature, recurrence after recovery, or cooldown elapsed).
TECHOPS_COORDINATOR_ENABLED=false
TECHOPS_TENANT=default
TECHOPS_INVESTIGATION_COOLDOWN_SECONDS=300
TECHOPS_RECURRENCE_WINDOW_SECONDS=3600
TECHOPS_DEDUP_RETENTION=50000
# live (default) rejects replay-tagged events; replay isolates them and never opens incidents
TECHOPS_PROCESSING_MODE=live
# Durable control state (observations, incidents, investigation requests, action ledger).
# Empty / memory:// = process-local (lost on restart); sqlite:///./data/control.sqlite = one host,
# survives restarts; postgresql://user:pass@host:5432/stag = multi-worker (pip install 'stag[postgres]').
CONTROL_STORE_URL=
# Worker identity used when leasing investigation requests (default: <hostname>:<pid>)
TECHOPS_WORKER_ID=
TECHOPS_INVESTIGATION_LEASE_SECONDS=300
INDEX_TIMEOUT_SECONDS=5.0

# --- Server ---
HOST=127.0.0.1   # no authentication: keep the demo loopback-bound
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Simulator ---
SIMULATOR_INTERVAL=3.0
SIMULATOR_SCENARIO=enterprise_ai
# Options: enterprise_ai, cybersecurity, financial, compliance
